{
    "name": "componenta/clock",
    "description": "PSR-20 clock integration for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "componenta/config": "^3.0.0",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Clock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Clock\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit tests"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Clock\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
